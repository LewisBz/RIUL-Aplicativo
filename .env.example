# Copiar a .env y ajustar valores (el archivo .env NO se commitea)

# --- MySQL (contenedor) ---
MYSQL_USER=riul
MYSQL_PASSWORD=riul
MYSQL_DATABASE=riul
MYSQL_ROOT_PASSWORD=riulroot

# URL desde la máquina host (pytest). El contenedor expone 3307
# porque el host puede tener un MySQL local en 3306.
DATABASE_URL=mysql+pymysql://riul:riul@localhost:3307/riul
TEST_DATABASE_URL=mysql+pymysql://riul:riul@localhost:3307/riul_test
MYSQL_ADMIN_URL=mysql+pymysql://root:riulroot@localhost:3307/mysql

# --- Seguridad ---
JWT_SECRET_KEY=cambia-esta-clave-en-produccion
SECRET_KEY=cambia-esta-clave-en-produccion

# --- CORS ---
# Orígenes permitidos separados por coma. "*" solo en desarrollo.
# (la configuración "prod" exige orígenes explícitos y secretos reales)
CORS_ORIGINS=*

# --- Reglas de negocio ---
INSTITUTIONAL_EMAIL_DOMAIN=unilibre.edu.co

# --- Administrador demo (solo desarrollo; no usar secretos reales) ---
ADMIN_DEMO_EMAIL=admin.demo@unilibre.edu.co
ADMIN_DEMO_PASSWORD=cambia-esta-clave-local
ADMIN_DEMO_NAME=Administrador Demo

# --- Usuarios demo (flask seed-demo, se ejecuta al arrancar el contenedor) ---
# Contraseña común de todos los usuarios sembrados (default: RiulDemo2026*)
DEMO_USERS_PASSWORD=RiulDemo2026*
# El seed carga 15 usuarios con roles/estados correctos. Catálogo completo:
#   administrators: ana.restrepo@unilibre.edu.co, leonardo.pardo@unilibre.edu.co
#   leaders: laura.mendoza@..., maria.antonieta.perez@..., mateo.silva@...,
#            javier.torres@...
#   researchers: camila.rojas@..., andres.perez@..., luis.grandett@...,
#                carolina.martinez@..., diego.gutierrez@...,
#                paula.fernandez@..., sofia.diaz@...
#   pending:     isabela.blanco@gmail.com  (login: "Solicitud pendiente")
#   rejected:    tomas.restrepo@hotmail.com (login: "Cuenta no autorizada")
# Resumen de tablas y datos: docs/tablas-y-datos.md

# --- Arranque del contenedor ---
# 1 (defecto): al iniciar, lask seed-demo REEMPLAZA usuarios y datos con el dataset demo.
# 0: solo siembra catálogos (facultades, programas, niveles, insignias, tipos de logro) y conserva los datos.
SEED_DEMO=1

# --- Pruebas dentro de Docker ---
# docker compose --profile test run --rm tests
