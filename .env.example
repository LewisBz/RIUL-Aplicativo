# Copiar a .env y ajustar valores (el archivo .env NO se commitea)

# --- PostgreSQL (contenedor) ---
POSTGRES_USER=riul
POSTGRES_PASSWORD=riul
POSTGRES_DB=riul

# URL desde la máquina host (para tests con pytest; el contenedor expone 5433
# porque el host puede tener un PostgreSQL local en 5432)
DATABASE_URL=postgresql+psycopg://riul:riul@localhost:5433/riul
TEST_DATABASE_URL=postgresql+psycopg://riul:riul@localhost:5433/riul_test

# --- Seguridad ---
JWT_SECRET_KEY=cambia-esta-clave-en-produccion
SECRET_KEY=cambia-esta-clave-en-produccion

# --- Reglas de negocio ---
INSTITUTIONAL_EMAIL_DOMAIN=unilibre.edu.co

# --- Administrador demo (solo desarrollo; no usar secretos reales) ---
ADMIN_DEMO_EMAIL=admin.demo@unilibre.edu.co
ADMIN_DEMO_PASSWORD=cambia-esta-clave-local
ADMIN_DEMO_NAME=Administrador Demo

# --- Usuarios demo (flask seed-demo, se ejecuta al arrancar el contenedor) ---
# Contraseña común de todos los usuarios sembrados (default: RiulDemo2026*)
DEMO_USERS_PASSWORD=RiulDemo2026*
# El seed carga 15 usuarios con roles/estados correctos. Catálogo completo:
